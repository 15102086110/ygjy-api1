/* pages/building/building.wxss */
page {
  background-color: #f8f9fa;
}

.container {
  padding: 24rpx;
}

/* 统计栏 */
.stats-bar {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-num {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
}

.stat-item.sold .stat-num {
  color: #1890ff;
}

.stat-item.unsale .stat-num {
  color: #ff6b6b;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 房间表格 */
.room-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.floor-section {
  margin-bottom: 32rpx;
}

.floor-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.room-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.room-item {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
  color: #666;
}

/* 已签约 - 蓝色 */
.room-item.signed {
  background: #e6f7ff;
  color: #1890ff;
}

/* 可售 - 绿色 */
.room-item.unsale {
  background: #f6ffed;
  color: #52c41a;
}

/* 锁定/预留 - 橙色 */
.room-item.locked {
  background: #fff7e6;
  color: #fa8c16;
}

.empty {
  text-align: center;
  padding: 60rpx;
  color: #999;
}

.loading {
  text-align: center;
  padding: 60rpx;
  color: #999;
}