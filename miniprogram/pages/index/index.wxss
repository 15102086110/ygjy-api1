/* pages/index/index.wxss */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.container {
  padding: 0;
}

/* Tab栏 */
.tab-bar {
  display: flex;
  background: #fff;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 100;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: #999;
  position: relative;
}

.tab-item.active {
  color: #1890ff;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #1890ff;
  border-radius: 3rpx;
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 0 24rpx 24rpx;
  padding: 16rpx 20rpx;
  border-radius: 48rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.search-btn {
  font-size: 28rpx;
  color: #1890ff;
  font-weight: 600;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  background: linear-gradient(135deg, #1890ff 0%, #36a3ff 100%);
  padding: 40rpx 24rpx;
  margin: 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.3);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

.stat-divider {
  width: 1rpx;
  background: rgba(255,255,255,0.3);
  margin: 8rpx 0;
}

/* 排行榜头部 */
.list-header {
  display: flex;
  align-items: center;
  padding: 0 24rpx 16rpx;
}

.rank-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.rank-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

/* 排行榜列表 */
.rank-list {
  padding: 0 24rpx 24rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

/* 排名 */
.rank-num {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #999;
  background: #f5f5f5;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.rank-num.top {
  background: linear-gradient(135deg, #ffd700 0%, #ffb700 100%);
  color: #fff;
}

.rank-item:nth-child(1) .rank-num {
  background: linear-gradient(135deg, #ffd700 0%, #ffb700 100%);
  color: #fff;
}

.rank-item:nth-child(2) .rank-num {
  background: linear-gradient(135deg, #c0c0c0 0%, #a0a0a0 100%);
  color: #fff;
}

.rank-item:nth-child(3) .rank-num {
  background: linear-gradient(135deg, #cd7f32 0%, #b87333 100%);
  color: #fff;
}

/* 楼盘信息 */
.rank-info {
  flex: 1;
}

.rank-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.rank-detail {
  font-size: 26rpx;
  color: #999;
}

.dot {
  margin: 0 8rpx;
}

/* 网签数 */
.rank-sold {
  text-align: right;
  margin-left: 16rpx;
}

.sold-num {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1890ff;
}

.sold-label {
  font-size: 22rpx;
  color: #999;
}

/* 加载状态 */
.loading, .empty {
  text-align: center;
  padding: 60rpx;
  color: #999;
}

/* 年份筛选栏 */
.year-scroll {
  background: #fff;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 97rpx; /* tab-bar高度 */
  z-index: 99;
}

.year-bar {
  display: flex;
  padding: 16rpx 24rpx;
  white-space: nowrap;
}

.year-item {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
}

.year-item.active {
  background: #1890ff;
  color: #fff;
  font-weight: 600;
}

.rank-presell {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}